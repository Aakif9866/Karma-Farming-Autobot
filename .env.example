# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=local
APP_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars
LOG_LEVEL=INFO

# Postgres (docker compose builds DATABASE_URL from these)
POSTGRES_USER=kfa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kfa
# Password for the SELECT-only role used by the Postgres MCP (created on first DB init)
KFA_READONLY_PASSWORD=change-me-too

# Only for running the backend/tests outside docker (compose overrides these)
DATABASE_URL=postgresql+psycopg://kfa:change-me@localhost:5432/kfa
REDIS_URL=redis://localhost:6379/0

# Bootstrap admin login (created once by the migrate container)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-strong-password

# --- Later phases (leave blank for now) ---
# Reddit: separate read-only account, script app (Phase 2)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=
# Groq free tier, no card (Phase 4)
GROQ_API_KEY=
# Salt for hashing Reddit usernames (Phase 2)
AUTHOR_HASH_SALT=
